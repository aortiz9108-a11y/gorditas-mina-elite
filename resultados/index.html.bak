<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gorditas Mina de Doña Caro - ¡Participa y Gana!</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Poppins', sans-serif;
            background: #0a0502;
            color: #fff;
            overflow-x: hidden;
        }
        :root {
            --rojo-hambre: #E63946;
            --naranja-antojo: #FF6B35;
            --amarillo-atencion: #FFD166;
            --cafe-calidez: #6F4E37;
            --crema-confianza: #FDF0D5;
            --azul-seguridad: #1D3557;
            --dorado-premium: #F4A261;
            --facebook: #1877f2;
        }
        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(40px); }
            to { opacity: 1; transform: translateY(0); }
        }
        @keyframes pulseRed {
            0% { transform: scale(1); box-shadow: 0 0 0 0 var(--rojo-hambre); }
            70% { transform: scale(1.02); box-shadow: 0 0 0 15px rgba(230,57,70,0); }
            100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(230,57,70,0); }
        }
        @keyframes float {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-8px); }
        }
        @keyframes ruletaSpin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
        @keyframes marquee {
            0% { transform: translateX(100%); }
            100% { transform: translateX(-100%); }
        }
        @keyframes bounce {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-12px); }
        }
        .hero {
            position: relative;
            height: 90vh;
            background: linear-gradient(135deg, rgba(0,0,0,0.5), rgba(0,0,0,0.6)), url('https://upload.wikimedia.org/wikipedia/commons/f/f9/Cerro_de_Proa%C3%B1o%2C_Fresnillo%2C_Zacatecas.jpg') center/cover fixed no-repeat;
            background-size: cover;
            background-position: center 30%;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
        }
        .hero::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: radial-gradient(circle at 30% 40%, rgba(255,107,53,0.2), transparent);
        }
        .hero-content { position: relative; z-index: 2; animation: fadeInUp 1.2s ease-out; }
        .hero h1 { 
            font-size: 4rem; 
            margin-bottom: 1rem; 
            background: linear-gradient(135deg, var(--amarillo-atencion), var(--naranja-antojo));
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            text-shadow: 2px 2px 10px rgba(0,0,0,0.3);
        }
        .hero p { font-size: 1.2rem; margin-bottom: 2rem; color: var(--crema-confianza); text-shadow: 1px 1px 2px rgba(0,0,0,0.5); }
        .btn {
            padding: 14px 38px;
            border-radius: 60px;
            text-decoration: none;
            font-size: 1.1rem;
            font-weight: bold;
            display: inline-block;
            margin: 0 10px;
            transition: all 0.3s;
            box-shadow: 0 8px 20px rgba(0,0,0,0.3);
        }
        .btn-whatsapp { 
            background: linear-gradient(135deg, #25D366, #128C7E); 
            color: white; 
            animation: pulseRed 2s infinite;
        }
        .btn-whatsapp:hover { transform: scale(1.05); background: #128C7E; }
        .btn-facebook {
            background: linear-gradient(135deg, var(--facebook), #0d65d9);
            color: white;
        }
        .btn-facebook:hover { transform: scale(1.05); background: #0d65d9; }
        .horario-destacado {
            background: linear-gradient(135deg, var(--rojo-hambre), var(--naranja-antojo));
            text-align: center;
            padding: 15px;
            font-weight: bold;
            font-size: 1rem;
            box-shadow: 0 5px 20px rgba(230,57,70,0.3);
        }
        .menu-section {
            background: rgba(29,53,87,0.9);
            backdrop-filter: blur(8px);
            border-radius: 30px;
            padding: 40px;
            margin: 30px 20px;
            border: 1px solid var(--dorado-premium);
            box-shadow: 0 15px 35px rgba(0,0,0,0.4);
        }
        .menu-title {
            text-align: center;
            font-size: 2.2rem;
            color: var(--amarillo-atencion);
            margin-bottom: 30px;
            display: inline-block;
            width: auto;
            border-bottom: 3px solid var(--naranja-antojo);
            padding-bottom: 10px;
        }
        .menu-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
            gap: 18px;
        }
        .menu-item {
            background: linear-gradient(135deg, rgba(0,0,0,0.6), rgba(111,78,55,0.4));
            padding: 16px;
            border-radius: 20px;
            text-align: center;
            transition: all 0.3s;
            border: 1px solid rgba(255,209,102,0.3);
            cursor: pointer;
        }
        .menu-item:hover { 
            background: linear-gradient(135deg, var(--azul-seguridad), var(--cafe-calidez)); 
            transform: translateY(-5px) scale(1.02);
            border-color: var(--amarillo-atencion);
            box-shadow: 0 10px 25px rgba(0,0,0,0.3);
        }
        .menu-item i { font-size: 2rem; margin-bottom: 8px; color: var(--naranja-antojo); }
        .menu-item strong { color: var(--amarillo-atencion); font-size: 1.1rem; display: block; margin-top: 5px; }
        .precio-destacado {
            background: linear-gradient(135deg, var(--rojo-hambre), var(--naranja-antojo));
            border-radius: 40px;
            padding: 35px;
            text-align: center;
            margin: 30px 20px;
            box-shadow: 0 10px 30px rgba(230,57,70,0.5);
            animation: pulseRed 2s infinite;
        }
        .precio-destacado .numero {
            font-size: 5rem;
            font-weight: 800;
            color: var(--amarillo-atencion);
            text-shadow: 3px 3px 6px rgba(0,0,0,0.3);
        }
        .comentarios-section {
            background: linear-gradient(135deg, var(--azul-seguridad), var(--cafe-calidez));
            border-radius: 35px;
            padding: 35px;
            margin: 30px 20px;
            border: 2px solid var(--dorado-premium);
        }
        .comentario-card {
            background: rgba(255,255,255,0.1);
            backdrop-filter: blur(10px);
            padding: 20px;
            border-radius: 20px;
            margin-bottom: 20px;
            transition: all 0.3s;
        }
        .comentario-card:hover { transform: translateX(10px); background: rgba(255,255,255,0.15); }
        .formulario-comentario {
            display: flex;
            gap: 15px;
            margin-top: 30px;
            flex-wrap: wrap;
        }
        .formulario-comentario input, .formulario-comentario textarea, .formulario-comentario select {
            padding: 15px;
            border-radius: 15px;
            border: none;
            background: rgba(255,255,255,0.9);
            font-size: 1rem;
        }
        .formulario-comentario input { flex: 1; }
        .formulario-comentario textarea { flex: 2; }
        .formulario-comentario select { width: 120px; }
        .btn-enviar {
            background: var(--naranja-antojo);
            color: white;
            padding: 15px 30px;
            border: none;
            border-radius: 15px;
            cursor: pointer;
            transition: all 0.3s;
        }
        .btn-enviar:hover { transform: scale(1.05); background: var(--rojo-hambre); }
        .subir-fotos-section {
            background: linear-gradient(135deg, var(--azul-seguridad), var(--cafe-calidez));
            border-radius: 35px;
            padding: 35px;
            margin: 30px 20px;
            border: 2px solid var(--dorado-premium);
        }
        .galeria-usuarios {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-top: 20px;
        }
        .foto-usuario {
            background: rgba(0,0,0,0.5);
            border-radius: 15px;
            padding: 15px;
            text-align: center;
            transition: all 0.3s;
        }
        .foto-usuario:hover { transform: scale(1.02); background: var(--azul-seguridad); }
        .foto-usuario img { width: 100%; height: 150px; object-fit: cover; border-radius: 10px; margin-bottom: 10px; }
        .rifa-section {
            background: linear-gradient(135deg, var(--azul-seguridad), var(--cafe-calidez));
            border-radius: 35px;
            padding: 40px;
            text-align: center;
            margin: 30px 20px;
            border: 2px solid var(--dorado-premium);
            animation: float 3s ease-in-out infinite;
        }
        .ruleta-container {
            background: linear-gradient(135deg, var(--azul-seguridad), var(--cafe-calidez));
            border-radius: 35px;
            padding: 35px;
            text-align: center;
            margin: 30px 20px;
            border: 2px solid var(--naranja-antojo);
        }
        .ruleta-btn {
            background: linear-gradient(135deg, var(--amarillo-atencion), var(--naranja-antojo));
            color: var(--azul-seguridad);
            padding: 18px 50px;
            font-size: 1.4rem;
            font-weight: bold;
            border: none;
            border-radius: 60px;
            cursor: pointer;
            transition: all 0.3s;
            margin: 20px;
            animation: bounce 1.5s infinite;
        }
        .ruleta-btn:hover { transform: scale(1.05); background: var(--naranja-antojo); }
        .premio { font-size: 1.3rem; margin-top: 20px; color: var(--amarillo-atencion); }
        .galeria-comida {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 25px;
            padding: 20px;
        }
        .galeria-item {
            border-radius: 25px;
            overflow: hidden;
            transition: all 0.4s;
            box-shadow: 0 10px 25px rgba(0,0,0,0.3);
            border: 2px solid transparent;
        }
        .galeria-item:hover { 
            transform: scale(1.03); 
            border-color: var(--naranja-antojo);
            box-shadow: 0 15px 35px var(--naranja-antojo);
        }
        .galeria-item img { width: 100%; height: 230px; object-fit: cover; transition: all 0.4s; }
        .galeria-item:hover img { transform: scale(1.05); }
        .info-card {
            background: linear-gradient(135deg, rgba(29,53,87,0.9), rgba(111,78,55,0.9));
            backdrop-filter: blur(5px);
            border-radius: 25px;
            padding: 25px;
            text-align: center;
            margin: 20px;
            border: 1px solid var(--dorado-premium);
            transition: all 0.3s;
        }
        .info-card:hover { transform: translateY(-5px); border-color: var(--naranja-antojo); }
        .social-buttons {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin-top: 20px;
            flex-wrap: wrap;
        }
        .float-wpp {
            position: fixed;
            bottom: 25px;
            right: 25px;
            background: linear-gradient(135deg, #25D366, #128C7E);
            width: 65px;
            height: 65px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            box-shadow: 0 8px 20px rgba(0,0,0,0.3);
            transition: all 0.3s;
            z-index: 1000;
            animation: pulseRed 2s infinite;
        }
        .float-wpp:hover { transform: scale(1.12); background: #128C7E; }
        .float-wpp a { color: white; text-decoration: none; }
        .promo-marquee {
            background: linear-gradient(135deg, var(--rojo-hambre), var(--naranja-antojo));
            color: var(--crema-confianza);
            padding: 12px;
            font-weight: bold;
            overflow: hidden;
            white-space: nowrap;
            font-size: 0.9rem;
        }
        .promo-marquee p { display: inline-block; animation: marquee 20s linear infinite; }
        footer { 
            background: linear-gradient(135deg, var(--azul-seguridad), var(--cafe-calidez));
            text-align: center; 
            padding: 40px; 
            margin-top: 40px; 
            border-top: 3px solid var(--dorado-premium);
        }
        .container { max-width: 1400px; margin: 0 auto; padding: 30px 20px; }
        .section-title { 
            text-align: center; 
            font-size: 2.2rem; 
            margin-bottom: 35px; 
            background: linear-gradient(135deg, var(--amarillo-atencion), var(--naranja-antojo));
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }
        @media (max-width: 768px) {
            .hero h1 { font-size: 2rem; }
            .menu-grid { grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); }
            .precio-destacado .numero { font-size: 3rem; }
            .section-title { font-size: 1.6rem; }
            .social-buttons { flex-direction: column; align-items: center; }
            .formulario-comentario { flex-direction: column; }
        }
    </style>
</head>
<body>
    <div class="promo-marquee">
        <p>🔥 ¡ESPECIAL! 🔥 Chicharrón con Cuero | 🌽 Pozole y Tamales SÁBADOS 4pm | 🎁 Rifa semanal | 🥤 Refresco gratis por WhatsApp 🔥</p>
    </div>
    <div class="float-wpp">
        <a href="https://wa.me/524931069671?text=¡Hola!%20Quiero%20hacer%20un%20pedido%20de%20gorditas%20🍽️" target="_blank">
            <i class="fab fa-whatsapp"></i>
        </a>
    </div>
    <div class="hero">
        <div class="hero-content">
            <h1>🇲🇽 Gorditas Mina de Doña Caro 🇲🇽</h1>
            <p>📍 Calle Fco. Javier Mina #2, Colonia Centro, Fresnillo, Zacatecas</p>
            <p>📞 Servicio a domicilio: <strong>493 106 9671</strong></p>
            <div class="social-buttons">
                <a href="https://wa.me/524931069671?text=¡Hola!%20Quiero%20hacer%20un%20pedido%20de%20gorditas%20🍽️" class="btn btn-whatsapp">📱 ORDENA POR WhatsApp</a>
                <a href="https://www.facebook.com/profile.php?id=61580942190641" class="btn btn-facebook" target="_blank">👍 SÍGUENOS EN Facebook</a>
            </div>
        </div>
    </div>
    <div class="horario-destacado">
        <p>🕐 <strong>GORDITAS:</strong> Lunes a Jueves 8:30am - 2pm | 🌽 <strong>POZOLE Y TAMALES:</strong> Sábados 4pm hasta agotar</p>
        <p>🔥 <strong>¡CHICHARRÓN CON CUERO!</strong> - El favorito de todos 🔥</p>
    </div>
    <div class="precio-destacado">
        <h2>🔥 PRECIO ESPECIAL 🔥</h2>
        <div class="numero">¡SOLO $18!</div>
        <p>Gorditas al comal • Hechas al momento</p>
        <p>🥤 ¡Bebidas frías y refrescos disponibles!</p>
        <p>⭐ ¡El mejor precio de Fresnillo! ⭐</p>
    </div>
    <div class="container">
        <h2 class="section-title">🍽️ ¡PROVOCA TU ANTOJO! 🍽️</h2>
        <div class="galeria-comida">
            <div class="galeria-item"><img src="https://images.unsplash.com/photo-1589301760014-6d6f5f8b5b5b?w=400" alt="Gordita"></div>
            <div class="galeria-item"><img src="https://images.unsplash.com/photo-1565299585323-38d6b0865b47?w=400" alt="Gordita"></div>
            <div class="galeria-item"><img src="https://images.unsplash.com/photo-1600628421066-f6bda6a1a9b9?w=400" alt="Gordita"></div>
            <div class="galeria-item"><img src="https://images.unsplash.com/photo-1555939594-58d7cb561ad1?w=400" alt="Gordita"></div>
        </div>
    </div>
    <!-- MENÚ ÉLITE CON ICONOS -->
    <div class="menu-section">
        <div style="text-align: center;">
            <h2 class="menu-title">🌮 GORDITAS AL COMAL 🌮</h2>
        </div>
        <div class="menu-grid">
            <div class="menu-item"><i class="fas fa-cow"></i><strong>Lengua</strong><span>SOLO LUNES</span></div>
            <div class="menu-item"><i class="fas fa-drumstick-bite"></i><strong>Moronga</strong><span>SOLO MARTES</span></div>
            <div class="menu-item"><i class="fas fa-utensils"></i><strong>Bistek</strong></div>
            <div class="menu-item"><i class="fas fa-hamburger"></i><strong>Picadillo</strong></div>
            <div class="menu-item"><i class="fas fa-drumstick"></i><strong>Deshebrada</strong></div>
            <div class="menu-item"><i class="fas fa-leaf"></i><strong>Nopales con chile rojo</strong></div>
            <div class="menu-item"><i class="fas fa-leaf"></i><strong>Nopales con huevo</strong></div>
            <div class="menu-item"><i class="fas fa-egg"></i><strong>Huevo con chile</strong></div>
            <div class="menu-item"><i class="fas fa-piggy-bank"></i><strong>Trozo de puerco</strong></div>
            <div class="menu-item"><i class="fas fa-pepper-hot"></i><strong>Rajas</strong></div>
            <div class="menu-item"><i class="fas fa-bacon"></i><strong>Chicharrón</strong></div>
            <div class="menu-item"><i class="fas fa-fire"></i><strong>Chicharrón con Cuero</strong><span>🔥 ESPECIAL 🔥</span></div>
            <div class="menu-item"><i class="fas fa-drumstick-bite"></i><strong>Mole rojo</strong></div>
            <div class="menu-item"><i class="fas fa-drumstick-bite"></i><strong>Mole verde</strong></div>
            <div class="menu-item"><i class="fas fa-seedling"></i><strong>Frijoles</strong></div>
            <div class="menu-item"><i class="fas fa-cheese"></i><strong>Queso</strong></div>
        </div>
    </div>
    <!-- BEBIDAS CON ICONOS -->
    <div class="menu-section">
        <div style="text-align: center;">
            <h2 class="menu-title">🥤 BEBIDAS 🥤</h2>
        </div>
        <div class="menu-grid">
            <div class="menu-item"><i class="fas fa-mug-hot"></i><strong>Café</strong></div>
            <div class="menu-item"><i class="fas fa-glass-water"></i><strong>Agua de Jamaica</strong></div>
            <div class="menu-item"><i class="fab fa-cuttlefish"></i><strong>Pepsi</strong></div>
            <div class="menu-item"><i class="fas fa-wine-bottle"></i><strong>Jarrito</strong></div>
            <div class="menu-item"><i class="fas fa-glass-cheers"></i><strong>Seven Up</strong></div>
        </div>
    </div>
    <!-- SECCIÓN DE COMENTARIOS Y CALIFICACIONES -->
    <div class="comentarios-section">
        <h2 class="section-title">💬 OPINIONES Y CALIFICACIONES</h2>
        <div id="lista-comentarios">
            <div class="comentario-card"><div class="estrellas" style="color: var(--amarillo-atencion);">⭐⭐⭐⭐⭐</div><p>"¡El chicharrón con cuero está para chuparse los dedos!"</p><h4>- Carlos Rivera</h4><small>★★★★★ (5/5)</small></div>
            <div class="comentario-card"><div class="estrellas" style="color: var(--amarillo-atencion);">⭐⭐⭐⭐⭐</div><p>"Las mejores gorditas de Fresnillo, súper recomendadas"</p><h4>- María Fernández</h4><small>★★★★★ (5/5)</small></div>
            <div class="comentario-card"><div class="estrellas" style="color: var(--amarillo-atencion);">⭐⭐⭐⭐⭐</div><p>"El pozole del sábado está increíble, ¡no se lo pierdan!"</p><h4>- Liz Alvarez</h4><small>★★★★★ (5/5)</small></div>
        </div>
        <h3 style="text-align: center; margin-top: 30px;">✨ ¡DÉJANOS TU OPINIÓN Y GANA! ✨</h3>
        <p style="text-align: center;">Comenta y califica para participar en la RIFA SEMANAL</p>
        <div class="formulario-comentario">
            <input type="text" id="nombre" placeholder="Tu nombre">
            <select id="calificacion"><option value="5">★★★★★ (5 estrellas)</option><option value="4">★★★★☆ (4 estrellas)</option><option value="3">★★★☆☆ (3 estrellas)</option><option value="2">★★☆☆☆ (2 estrellas)</option><option value="1">★☆☆☆☆ (1 estrella)</option></select>
            <textarea id="comentario" placeholder="Tu comentario..." rows="2"></textarea>
            <button class="btn-enviar" onclick="agregarComentario()">Enviar y Participar</button>
        </div>
    </div>
    <!-- SECCIÓN PARA SUBIR FOTOS -->
    <div class="subir-fotos-section">
        <h2 class="section-title">📸 COMPARTE TUS FOTOS</h2>
        <p style="text-align: center;">Sube tus fotos disfrutando de nuestras gorditas y participa en la rifa</p>
        <div class="formulario-comentario">
            <input type="text" id="nombreFoto" placeholder="Tu nombre">
            <input type="text" id="urlFoto" placeholder="URL de tu foto (o usa placeholder)">
            <button class="btn-enviar" onclick="agregarFoto()">📤 Subir Foto</button>
        </div>
        <div id="galeria-usuarios" class="galeria-usuarios">
            <div class="foto-usuario"><img src="https://images.unsplash.com/photo-1589301760014-6d6f5f8b5b5b?w=200" alt="Foto cliente"><p><strong>Carlos</strong></p><small>¡Deliciosas!</small></div>
            <div class="foto-usuario"><img src="https://images.unsplash.com/photo-1565299585323-38d6b0865b47?w=200" alt="Foto cliente"><p><strong>María</strong></p><small>Las mejores</small></div>
        </div>
    </div>
    <!-- RIFA SEMANAL -->
    <div class="rifa-section">
        <h2>🎁 ¡RIFA SEMANAL! 🎁</h2>
        <p style="font-size: 1.8rem;">🍽️ <strong>Lonche Gratis</strong> 🍽️</p>
        <p>✨ <strong>CADA COMENTARIO Y FOTO = 1 PARTICIPACIÓN</strong> ✨</p>
        <p>Entre más participes, más chances de ganar</p>
        <p>Cada semana sorteamos un lonche gratis entre todos los que participen</p>
        <p>🔥 <strong>¿Cómo participar?</strong> 🔥</p>
        <p>1️⃣ Comenta y califica</p>
        <p>2️⃣ Sube tus fotos</p>
        <p>3️⃣ Gira la ruleta</p>
        <p>4️⃣ Haz tu pedido por WhatsApp</p>
        <br>
        <div class="social-buttons">
            <a href="https://wa.me/524931069671?text=¡Hola!%20Quiero%20participar%20en%20la%20rifa%20🍽️%20Mi%20nombre%20es:%20" class="btn btn-whatsapp">🎲 Participar ahora</a>
            <a href="https://www.facebook.com/profile.php?id=61580942190641" class="btn btn-facebook" target="_blank">👍 Síguenos en Facebook</a>
        </div>
    </div>
    <!-- RULETA DE PROMOCIONES -->
    <div class="ruleta-container">
        <h2 style="color: var(--amarillo-atencion);">🎡 ¡GIRA LA RULETA! 🎡</h2>
        <p style="margin-bottom: 10px;">🎁 Gira y gana premios instantáneos 🎁</p>
        <button class="ruleta-btn" onclick="girarRuleta()">🎲 GIRAR RULETA 🎲</button>
        <div id="premio" class="premio">¡Gira para ganar un premio!</div>
        <p style="margin-top: 15px;">🔥 Válido por 24 horas | Canjea con tu pedido 🔥</p>
    </div>
    <!-- INFORMACIÓN DEL LOCAL -->
    <div class="container">
        <div class="info-card"><h3>📍 Dirección</h3><p>Calle Fco. Javier Mina #2, entre Nuevo León y Chihuahua</p><p>Colonia Centro, Fresnillo, Zacatecas</p></div>
        <div class="info-card"><h3>📞 Servicio a domicilio</h3><p><strong>493 106 9671</strong></p><a href="tel:4931069671" style="color: var(--naranja-antojo);">Llamar ahora</a></div>
        <div class="info-card"><h3>🕐 Horario</h3><p><strong>Gorditas:</strong> Lunes a Jueves 8:30am - 2pm</p><p><strong>Pozole y Tamales:</strong> Sábados desde 4pm</p><p>🔥 Lengua solo lunes | Moronga solo martes 🔥</p></div>
    </div>
    <!-- MAPA -->
    <div class="container">
        <h2 class="section-title">📍 ¿Dónde estamos?</h2>
        <div style="border-radius: 25px; overflow: hidden; border: 2px solid var(--naranja-antojo);">
            <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3719.123456!2d-102.876543!3d23.123456!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMjPCsDA3JzI0LjYiTiAxMDLCsDUyJzM1LjQiVw!5e0!3m2!1ses!2smx!4v1234567890" width="100%" height="300" style="border:0;" allowfullscreen></iframe>
        </div>
        <p style="text-align: center; margin-top: 15px;">📍 Calle Fco. Javier Mina #2, Centro, Fresnillo</p>
    </div>
    <footer>
        <p>🇲🇽 <strong>Gorditas Mina de Doña Caro</strong> 🇲🇽</p>
        <p>📍 Calle Fco. Javier Mina #2, Colonia Centro, Fresnillo, Zacatecas</p>
        <div class="social-buttons"><a href="https://wa.me/524931069671" style="color: var(--naranja-antojo); text-decoration: none;">📞 493 106 9671</a> | <a href="https://www.facebook.com/profile.php?id=61580942190641" target="_blank" style="color: var(--naranja-antojo); text-decoration: none;">👍 Facebook</a></div>
        <p>🕐 Gorditas: Lunes a Jueves 8:30am - 2pm</p>
        <p>🌽 Pozole y Tamales: Sábados desde 4pm</p>
        <p>🔥 <strong>¡Chicharrón con Cuero - El especial de la casa!</strong> 🔥</p>
        <p style="margin-top: 15px;">❤️ ¡Sabor que enamora en cada mordida! ❤️</p>
        <p style="margin-top: 10px;">⭐ ¡El mejor precio de Fresnillo! Solo $18 ⭐</p>
    </footer>
    <script>
        let contadorGiros = 0;
        let contadorPremiosGrandes = 0;
        function girarRuleta() {
            contadorGiros++;
            const premiosComunes = ["🥤 ¡Agua fresca GRATIS! 🥤","💰 ¡$5 pesos de descuento! 💰","🎲 ¡Sigue participando! Vuelve a intentar 🎲","🍽️ ¡Ordena 3 y llévate 1 gratis! 🍽️"];
            const premiosGrandes = ["🎉 ¡10% de descuento en tu próximo pedido! 🎉","🎁 ¡Un refresco extra GRATIS! 🎁","🔥 ¡2x1 en gorditas! 🔥","🎁 ¡Entras directo a la RIFA SEMANAL! 🎁"];
            const premioMega = "🏆 ¡COMBO COMPLETO GRATIS! (3 gorditas + refresco) 🏆";
            let premioFinal = "";
            let probGrande = 0.1;
            if (contadorGiros - contadorPremiosGrandes > 30) { probGrande = 0.5; }
            const random = Math.random();
            if (random < 0.01) { premioFinal = premioMega; contadorPremiosGrandes = contadorGiros; }
            else if (random < probGrande + 0.01) { const indice = Math.floor(Math.random() * premiosGrandes.length); premioFinal = premiosGrandes[indice]; contadorPremiosGrandes = contadorGiros; }
            else { const indice = Math.floor(Math.random() * premiosComunes.length); premioFinal = premiosComunes[indice]; }
            document.getElementById('premio').innerHTML = premioFinal;
            document.getElementById('premio').style.animation = 'ruletaSpin 0.5s ease-out';
            setTimeout(() => { document.getElementById('premio').style.animation = ''; }, 500);
            let mensajeWhatsApp = `🎡 ¡Ganaste! ${premioFinal} 🎡\n🔥 Válido por 24 horas - Muestra este mensaje al hacer tu pedido 🔥\n📱 Mi nombre es: `;
            let url = `https://wa.me/524931069671?text=${encodeURIComponent(mensajeWhatsApp)}`;
            if (confirm(`🎡 ¡Ganaste! ${premioFinal} 🎡\n\n¿Quieres reclamar tu premio por WhatsApp?`)) { window.open(url, '_blank'); }
        }
        function agregarComentario() {
            var nombre = document.getElementById('nombre').value;
            var comentario = document.getElementById('comentario').value;
            var calificacion = document.getElementById('calificacion').value;
            if(nombre && comentario) {
                var contenedor = document.getElementById('lista-comentarios');
                var nuevo = document.createElement('div');
                nuevo.className = 'comentario-card';
                var estrellas = '';
                for(var i = 0; i < calificacion; i++) estrellas += '⭐';
                nuevo.innerHTML = '<div class="estrellas" style="color: var(--amarillo-atencion);">' + estrellas + '</div><p>"' + comentario + '"</p><h4>- ' + nombre + '</h4><small>' + estrellas + ' (' + calificacion + '/5)</small>';
                contenedor.appendChild(nuevo);
                document.getElementById('nombre').value = '';
                document.getElementById('comentario').value = '';
                alert('🎁 ¡Gracias por tu comentario! Entras en la RIFA SEMANAL 🎁');
            } else { alert('Por favor completa todos los campos'); }
        }
        function agregarFoto() {
            var nombre = document.getElementById('nombreFoto').value;
            var url = document.getElementById('urlFoto').value;
            if(nombre && url) {
                var contenedor = document.getElementById('galeria-usuarios');
                var nuevo = document.createElement('div');
                nuevo.className = 'foto-usuario';
                nuevo.innerHTML = '<img src="' + url + '" alt="Foto de ' + nombre + '" onerror="this.src=\'https://images.unsplash.com/photo-1589301760014-6d6f5f8b5b5b?w=200\'"><p><strong>' + nombre + '</strong></p><small>¡Compartió su experiencia!</small>';
                contenedor.appendChild(nuevo);
                document.getElementById('nombreFoto').value = '';
                document.getElementById('urlFoto').value = '';
                alert('🎁 ¡Foto subida! Participas en la RIFA SEMANAL 🎁');
            } else { alert('Completa todos los campos (usa una URL de imagen válida)'); }
        }
    </script>
</body>
</html>
